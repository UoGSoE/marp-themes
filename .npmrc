# Don't install any version published less than a day ago. A poisoned
# release is usually detected and yanked within hours, so even a short
# cooldown filters most compromises. Days; needs npm >= 11.10.0.
min-release-age=1
# Don't run dependency lifecycle scripts (the postinstall hook most
# npm worms fire from). No package in this repo's tree declares one.
ignore-scripts=true
